{
  "name": "parking-app-backend",
  "version": "1.0.0",
  "description": "Node.js/Express backend for Parking App (converted from Spring Boot)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "build": "git clone ",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.5",
    "sockjs": "^0.3.24",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "mongodb-memory-server": "^10.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
